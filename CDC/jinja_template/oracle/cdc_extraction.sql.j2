-- Params: (columns,schema_name, table_name, delta, delta_column, delta_timestamp, where_conditions)

select 
    {%- for c in columns -%}
        {{ c }} {%- if not loop.last -%}, {%- endif -%}
    {%- endfor -%}
from {{ schema_name }}.{{ table_name }}
where 1 = 1 
    {%- if delta == True and delta_column and delta_timestamp %}
        and {{ delta_column }} >= '{{ delta_timestamp }}'
    {%- endif %}

    {%- if where_conditions is string and where_conditions|trim != '' %}
        and ( {{ where_conditions }} )
    {%- elif where_conditions is iterable
            and where_conditions is not string
            and where_conditions|select("string")|list|length > 0 %}
        {%- for cond in where_conditions if cond is not none and cond|trim != '' %}
        and ( {{ cond }} )
        {%- endfor %}
    {%- endif %}
;

